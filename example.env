# Environment selection is via --env on the CLI. A checkout exposes only the
# environments it is configured for: local, eu, and us are always available;
# the internal environments (dev-weu, staging-eu) appear only when their
# hydration variables (see "Internal operators" below) are set. Tenant comes
# from CORTI_TENANT_NAME ("base" when unset).
#
# Run `make setup` to fill this in interactively.

# ── External customer ────────────────────────────────────────────────
# The Corti Console's Developer Quickstart "Copy all as .env variables" block:
# it names your tenant, is the fallback OAuth client for any environment
# without its own credentials, and credentials the judge.
CORTI_TENANT_NAME=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET= # gitleaks:allow — empty template placeholder
CORTI_ENVIRONMENT=

# ── Judge (LLM-as-a-judge) ───────────────────────────────────────────
# Corti Models endpoint for judge expectations (expected_output_text).
# JUDGE_API_KEY is created automatically — DO NOT POPULATE.
# JUDGE_BASE_URL is written by `make setup` from CORTI_ENVIRONMENT (eu/us):
#   https://ai.<env>.corti.app/v1
JUDGE_API_KEY=
JUDGE_BASE_URL=https://ai.eu.corti.app/v1
JUDGE_MODEL=corti-s1-instant

# ── Opik (remote output) ─────────────────────────────────────────────
OPIK_URL_OVERRIDE=   # send sink writes + trace links to your own Opik instance
OPIK_PROJECT_NAME=    # default: Agents
OPIK_API_KEY=
